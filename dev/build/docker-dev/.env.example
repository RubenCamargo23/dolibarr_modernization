# Tickets microservice integration
# Copy this file to .env in this same directory before running docker compose.
#
# Internal: used server-side by TicketsMicroserviceClient (getURLContent),
# resolved via Docker's internal network (only reachable from within the
# "web" container).
TICKETS_MICROSERVICE_URL_INTERNAL=http://tickets-microservice:8000/api
# Public: used client-side by the fetch() calls in card.php/list.php,
# reachable from the browser on the host machine.
TICKETS_MICROSERVICE_URL_PUBLIC=http://localhost:8001/api
