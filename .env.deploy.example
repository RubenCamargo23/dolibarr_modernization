# Copy this file to .env.deploy and fill in real values.
# .env.deploy is gitignored — it holds plaintext secrets and must never be committed.

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

ECS_CLUSTER_NAME=tickets-cluster
ECS_SERVICE_NAME=dolibarr-app
ECR_REPO_NAME=dolibarr-app

# ALB (shared with tickets-microservice; leave blank to expose via public IP instead)
ALB_SG_ID=
TARGET_GROUP_ARN=

# RDS MySQL (Dolibarr's own instance, separate from the tickets microservice's)
DOLI_DB_SERVER=
DOLI_DB_PORT=3306
DOLI_DATABASE=dolibarr
DOLI_DB_USER=dolibarr
DOLI_DB_PASSWORD=

# Dolibarr app
DOLI_URL_ROOT=http://localhost
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=

# Tickets microservice integration (see htdocs/ticket/class/ticketsmicroserviceclient.class.php)
# Both should point at the ALB root — its /tickets* listener rule forwards to tickets-app.
TICKETS_MICROSERVICE_URL_INTERNAL=http://localhost
TICKETS_MICROSERVICE_URL_PUBLIC=http://localhost

# CloudWatch
LOG_GROUP=/ecs/dolibarr-app
